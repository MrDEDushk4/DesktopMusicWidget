<Window x:Class="DesktopMusicWidget.SecondWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop Music Widget"
        Width="250" Height="190"
        MinWidth="250" MinHeight="190"
        MaxWidth="510" MaxHeight="190"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Inter"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <Style x:Key="ControlButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBackground"
                                        Property="Background" Value="#35FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBackground"
                                        Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ListBoxItem}">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="ItemBorder"
                                CornerRadius="8"
                                ClipToBounds="True"
                                Background="#202020">
                            <Grid Height="46">
                                <Image x:Name="ItemBackdrop"
                                       Source="{Binding AlbumArt}"
                                       Stretch="UniformToFill"
                                       Opacity="0">
                                    <Image.Effect>
                                        <BlurEffect Radius="12"/>
                                    </Image.Effect>
                                </Image>
                                <Border x:Name="ItemShade" Background="#DD202020"/>
                                <ContentPresenter Margin="8,3"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBackdrop" Property="Opacity" Value="0.20"/>
                                <Setter TargetName="ItemShade" Property="Background" Value="#AA383838"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBackdrop" Property="Opacity" Value="0.48"/>
                                <Setter TargetName="ItemShade" Property="Background" Value="#A8202020"/>
                                <Setter Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Canvas x:Name="RootCanvas"
            Width="510" Height="190"
            ClipToBounds="False">

        <!-- Плейлист находится под основным блоком и выезжает влево. -->
        <Border x:Name="PlaylistPanel"
                Canvas.Left="-270" Canvas.Top="0"
                Width="270" Height="190"
                CornerRadius="10,0,0,10"
                Background="#202020"
                ClipToBounds="True"
                Visibility="Collapsed">
            <Grid x:Name="PlaylistContent" Margin="12,8,16,8">
                <Grid.Clip>
                    <PathGeometry>
                        <PathFigure StartPoint="10,0" IsClosed="True">
                            <LineSegment Point="270,0"/>
                            <LineSegment Point="270,174"/>
                            <LineSegment Point="10,174"/>
                            <ArcSegment Point="0,164" Size="10,10"
                                        SweepDirection="Counterclockwise"/>
                            <LineSegment Point="0,10"/>
                            <ArcSegment Point="10,0" Size="10,10"
                                        SweepDirection="Counterclockwise"/>
                        </PathFigure>
                    </PathGeometry>
                </Grid.Clip>
                <Grid.RowDefinitions>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="ПЛЕЙЛИСТ"
                           Foreground="#858585"
                           FontSize="10"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="3,0,0,5"/>

                <ListBox x:Name="ExpandedPlaylist"
                         Grid.Row="1"
                         ItemsSource="{Binding Tracks}"
                         Background="Transparent"
                         BorderThickness="0"
                         SelectionChanged="ExpandedPlaylist_SelectionChanged"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="42"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="31" Height="31"
                                        CornerRadius="5"
                                        Background="#383838"
                                        ClipToBounds="True"
                                        VerticalAlignment="Center">
                                    <Image Source="{Binding AlbumArt}"
                                           Stretch="UniformToFill"/>
                                </Border>

                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Margin="8,0,3,0">
                                    <TextBlock Text="{Binding Title}"
                                               Foreground="#EEEEEE"
                                               FontSize="10"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock FontSize="8.5"
                                               Foreground="#A5A5A5"
                                               TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Artist}"/>
                                        <Run Text="  ·  "/>
                                        <Run Text="{Binding Album}"/>
                                    </TextBlock>
                                </StackPanel>

                                <TextBlock Grid.Column="2"
                                           Text="{Binding DurationText}"
                                           Foreground="#929292"
                                           FontSize="8.5"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Основной блок имеет отдельное скруглённое отсечение содержимого. -->
        <Border x:Name="PlayerPanel"
                Canvas.Left="0" Canvas.Top="0"
                Width="250" Height="190"
                CornerRadius="10"
                Background="#242424"
                ClipToBounds="True"
                Panel.ZIndex="2">
            <Border.Effect>
                <DropShadowEffect Color="#000000"
                                  BlurRadius="18"
                                  ShadowDepth="5"
                                  Direction="180"
                                  Opacity="0.58"/>
            </Border.Effect>

            <Grid x:Name="PlayerContent" ClipToBounds="True">
                <Grid.Clip>
                    <RectangleGeometry Rect="0,0,250,190"
                                       RadiusX="10" RadiusY="10"/>
                </Grid.Clip>

                <Image x:Name="BackdropImage"
                       Stretch="UniformToFill"
                       Opacity="0.38">
                    <Image.Effect>
                        <BlurEffect Radius="22"/>
                    </Image.Effect>
                </Image>
                <Border Background="#C91B1B1B"/>

                <Grid Margin="12,8,12,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="22"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="18"/>
                    </Grid.RowDefinitions>

                    <!-- Обложка по центру сверху: 32x32. -->
                    <Border Grid.Row="0"
                            Width="32" Height="32"
                            CornerRadius="5"
                            Background="#414141"
                            ClipToBounds="True"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top">
                        <Image x:Name="CoverImage" Stretch="UniformToFill"/>
                    </Border>

                    <Button x:Name="PlaylistToggleButton"
                            Grid.Row="0"
                            Width="24" Height="24"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Style="{StaticResource ControlButton}"
                            Click="TogglePlaylist_Click"
                            ToolTip="Открыть плейлист"
                            FontSize="18"
                            Content="☷"/>

                    <!-- Название, исполнитель и альбом располагаются под обложкой. -->
                    <StackPanel Grid.Row="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <TextBlock x:Name="TrackTitle"
                                   Text="Выберите композицию"
                                   Foreground="#F1F1F1"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Width="220"/>
                        <TextBlock x:Name="TrackArtist"
                                   Text="Исполнитель · Альбом"
                                   Foreground="#B5B5B5"
                                   FontSize="9"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Width="220"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Управление воспроизведением по центру. -->
                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Button x:Name="DirectionButton"
                                Width="28" Height="30"
                                Style="{StaticResource ControlButton}"
                                Content="⇄"
                                FontSize="14"
                                Click="Direction_Click"
                                ToolTip="Направление воспроизведения"/>
                        <Button Width="32" Height="32"
                                Margin="3,0"
                                Style="{StaticResource ControlButton}"
                                Content="|◀"
                                FontSize="15"
                                Click="Previous_Click"/>
                        <Button x:Name="PlayButton"
                                Width="40" Height="38"
                                Margin="2,0"
                                Style="{StaticResource ControlButton}"
                                Content="▶"
                                FontSize="21"
                                Click="PlayPause_Click"/>
                        <Button Width="32" Height="32"
                                Margin="3,0"
                                Style="{StaticResource ControlButton}"
                                Content="▶|"
                                FontSize="15"
                                Click="Next_Click"/>
                        <Button x:Name="RepeatButton"
                                Width="28" Height="30"
                                Style="{StaticResource ControlButton}"
                                Content="⟳"
                                FontSize="16"
                                Click="Repeat_Click"
                                ToolTip="Повтор текущего трека"/>
                    </StackPanel>

                    <Slider x:Name="PositionSlider"
                            Grid.Row="3"
                            Minimum="0"
                            Maximum="1"
                            Value="0"
                            VerticalAlignment="Center"
                            PreviewMouseLeftButtonDown="Position_MouseDown"
                            PreviewMouseLeftButtonUp="Position_MouseUp"
                            ValueChanged="Position_ValueChanged"/>

                    <!-- Время воспроизведения и громкость. -->
                    <Grid Grid.Row="4" Margin="1,-2,1,0">
                        <TextBlock x:Name="ElapsedLabel"
                                   Text="0:00"
                                   Foreground="#A0A0A0"
                                   FontSize="8.5"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="RemainingLabel"
                                   Text="-0:00"
                                   Foreground="#A0A0A0"
                                   FontSize="8.5"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"/>
                        <Slider x:Name="VolumeSlider"
                                Minimum="0" Maximum="1" Value="0.7"
                                Width="82" Height="15"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                ValueChanged="Volume_ValueChanged"
                                ToolTip="Громкость"/>
                    </Grid>

                    <Button Grid.Row="5"
                            Width="16" Height="16"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Style="{StaticResource ControlButton}"
                            Content="⚙"
                            FontSize="12"
                            Click="Settings_Click"
                            ToolTip="Настройки"/>
                </Grid>
            </Grid>
        </Border>
    </Canvas>
</Window>
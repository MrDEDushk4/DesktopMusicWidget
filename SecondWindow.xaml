<Window x:Class="DesktopMusicWidget.SecondWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop Music Widget"
        Width="980" Height="400"
        MinWidth="760" MinHeight="340"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        FontFamily="Inter"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#B8B8B8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="31"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="10" Padding="7">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#303030"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#393939"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#202020" CornerRadius="22" Margin="7" ClipToBounds="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="PlaylistColumn" Width="47*"/>
                <ColumnDefinition x:Name="PlayerColumn" Width="53*"/>
            </Grid.ColumnDefinitions>

            <!-- Playlist -->
            <Border x:Name="PlaylistPanel" Grid.Column="0" Background="#202020" Padding="12,12,8,12">
                <ListBox x:Name="ExpandedPlaylist"
                         ItemsSource="{Binding Tracks}"
                         Background="Transparent"
                         BorderThickness="0"
                         SelectionChanged="ExpandedPlaylist_SelectionChanged"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="62">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="66"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="42"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="66" Height="58" CornerRadius="10" ClipToBounds="True"
                                        Background="#383838" VerticalAlignment="Center">
                                    <Image Source="{Binding AlbumArt}" Stretch="UniformToFill"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="11,0,5,0">
                                    <TextBlock Text="{Binding Title}" Foreground="#D0D0D0" FontSize="17"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Artist}" Foreground="#929292" FontSize="13"
                                               TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding DurationText}" Foreground="#777777"
                                           FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Player panel -->
            <Border x:Name="PlayerPanel" Grid.Column="1" Grid.ColumnSpan="1" CornerRadius="20" Margin="0,0,0,0" ClipToBounds="True">
                <Grid>
                    <Image x:Name="BackdropImage" Stretch="UniformToFill" Opacity="0.22">
                        <Image.Effect>
                            <BlurEffect Radius="24"/>
                        </Image.Effect>
                    </Image>
                    <Border Background="#B8202020"/>
                    <Grid Margin="24,14,24,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <TextBlock Text="NOW PLAYING" Foreground="#777777" FontSize="10"
                                       FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <Button Content="⚙" Click="Settings_Click" HorizontalAlignment="Right"
                                    Foreground="#777777" Background="Transparent" BorderThickness="0"
                                    FontSize="22" ToolTip="Настройки виджета"/>
                            <Button x:Name="PlaylistToggleButton" Content="☷" Click="TogglePlaylist_Click"
                                    HorizontalAlignment="Right" Margin="0,0,42,0"
                                    Foreground="#777777" Background="Transparent" BorderThickness="0"
                                    FontSize="20" ToolTip="Скрыть плейлист"/>
                            <Button Content="×" Click="SwitchToCompact_Click" HorizontalAlignment="Left"
                                    Foreground="#888888" Background="Transparent" BorderThickness="0"
                                    FontSize="20" ToolTip="Вернуться к компактному интерфейсу"/>
                        </Grid>

                        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border Width="94" Height="94" CornerRadius="15" Background="#383838"
                                    ClipToBounds="True" Margin="0,2,0,4">
                                <Image x:Name="CoverImage" Stretch="UniformToFill"/>
                            </Border>
                            <TextBlock x:Name="TrackTitle" Text="Выберите композицию" Foreground="#E0E0E0"
                                       FontSize="24" FontWeight="Medium" TextAlignment="Center"
                                       TextTrimming="CharacterEllipsis" MaxWidth="410" Margin="0,0,0,2"/>
                            <TextBlock x:Name="TrackArtist" Text="Плейлист пока пуст" Foreground="#A0A0A0"
                                       FontSize="16" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                       MaxWidth="410"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                                <Button x:Name="DirectionButton" Content="⇵" Style="{StaticResource IconButton}"
                                        FontSize="27" Click="Direction_Click" ToolTip="Изменить направление"/>
                                <Button Content="«" Style="{StaticResource IconButton}" Click="Previous_Click"/>
                                <Button x:Name="PlayButton" Content="▶" Style="{StaticResource IconButton}"
                                        FontSize="39" Click="PlayPause_Click" Margin="8,0"/>
                                <Button Content="»" Style="{StaticResource IconButton}" Click="Next_Click"/>
                                <Button x:Name="RepeatButton" Content="⟳" Style="{StaticResource IconButton}"
                                        Click="Repeat_Click" ToolTip="Повтор текущего трека"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="2">
                            <Slider x:Name="PositionSlider" Minimum="0" Maximum="1" Value="0"
                                    PreviewMouseLeftButtonDown="Position_MouseDown"
                                    PreviewMouseLeftButtonUp="Position_MouseUp"
                                    ValueChanged="Position_ValueChanged"
                                    Foreground="#B8B8B8"/>
                            <Grid Margin="0,-2,0,7">
                                <TextBlock x:Name="ElapsedLabel" Text="0:00" Foreground="#777777" FontSize="11"/>
                                <TextBlock x:Name="RemainingLabel" Text="-0:00" Foreground="#777777"
                                           FontSize="11" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="VolumeSlider" Minimum="0" Maximum="1" Value="0.7"
                                    ValueChanged="Volume_ValueChanged" Width="170"
                                    HorizontalAlignment="Center" Foreground="#B8B8B8"
                                    ToolTip="Громкость"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
